---
import { careerPath } from '../data/site';
---
<section class="section container">
  <p class="eyebrow">The journey so far</p>
  <ol class="path">
    {careerPath.map((step, i) => (
      <li data-reveal style={`transition-delay:${i * 120}ms`}>
        <span class="step">{step}</span>
        {i < careerPath.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
      </li>
    ))}
  </ol>
  <a class="btn btn-ghost" href="/work">See the full timeline</a>
</section>

<style>
  .path { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem; padding: 0; margin: 0 0 2rem; align-items: center; }
  .path li { display: flex; align-items: center; gap: 0.6rem; }
  .step {
    font-family: var(--font-heading); font-weight: 600; padding: 0.6rem 1.1rem;
    border-radius: 999px; background: var(--accent-soft); color: var(--accent);
  }
  .arrow { color: var(--terracotta); font-weight: 700; }
</style>
