---
import NinaSprite from './NinaSprite.astro';
---
<div class="nina" data-nina-root>
  <div class="bubble" data-nina-bubble role="status" aria-live="polite">
    <p data-nina-text></p>
    <div class="actions">
      <button type="button" data-nina-next>Another fact</button>
      <button type="button" data-nina-close aria-label="Close">✕</button>
    </div>
  </div>
  <button class="body" type="button" data-nina-pet aria-label="Nina the dog. Click for a fun fact">
    <span class="sprite" data-nina-sprite><NinaSprite /></span>
  </button>
</div>

<script>
  import { initNina } from '../scripts/nina';
  initNina();
</script>

<style is:global>
  .nina {
    position: fixed; top: 0; left: 0; z-index: 60; width: 100px; height: 115px;
    pointer-events: none; will-change: transform;
  }
  html[data-nina='off'] .nina { display: none; }
  .nina .body { all: unset; display: block; width: 100%; height: 100%; cursor: pointer; pointer-events: auto; }
  .nina .body:focus-visible { outline: 3px solid var(--terracotta); border-radius: 12px; }
  .nina .sprite { display: block; width: 100%; height: 100%; transition: transform 0.2s; }

  /* Speech bubble */
  .nina .bubble {
    position: absolute; bottom: calc(100% + 6px); left: 50%; width: 230px; margin-left: -115px;
    background: var(--surface); color: var(--text); border: 2px solid var(--accent); border-radius: 16px;
    padding: 0.75rem 0.9rem; font-size: 0.88rem; line-height: 1.4; box-shadow: var(--shadow);
    opacity: 0; transform: translateY(8px) scale(0.95); pointer-events: none; transition: opacity 0.25s, transform 0.25s;
  }
  .nina .bubble.is-open { opacity: 1; transform: none; pointer-events: auto; }
  .nina .bubble p { margin: 0 0 0.5rem; }
  .nina .bubble::after {
    content: ''; position: absolute; top: 100%; left: 50%; margin-left: -8px; width: 14px; height: 14px;
    background: var(--surface); border: solid var(--accent); border-width: 0 2px 2px 0; transform: translateY(-8px) rotate(45deg);
  }
  .nina.bubble-left .bubble { left: 0; margin-left: 0; }
  .nina.bubble-left .bubble::after { left: 40px; }
  .nina.bubble-right .bubble { left: auto; right: 0; margin-left: 0; }
  .nina.bubble-right .bubble::after { left: auto; right: 40px; }
  .nina.bubble-below .bubble { bottom: auto; top: calc(100% + 6px); }
  .nina.bubble-below .bubble::after { top: auto; bottom: 100%; transform: translateY(8px) rotate(225deg); }
  .nina .actions { display: flex; justify-content: space-between; gap: 0.5rem; }
  .nina .actions button {
    font: inherit; font-size: 0.78rem; font-weight: 700; color: var(--accent); background: transparent;
    border: 0; cursor: pointer; padding: 0.1rem 0.2rem;
  }
  .nina .actions button:hover { text-decoration: underline; }

  /* Nina is one illustration in two layers: the body, and a clipped copy of the tail that wags. */
  .nina-pup { position: relative; display: block; width: 100%; height: 100%; transform-origin: 50% 100%; animation: nina-breathe 3.2s ease-in-out infinite alternate; }
  .nina-pup img { position: absolute; inset: 0; width: 100%; height: 100%; user-select: none; -webkit-user-drag: none; }
  /* Tail polygon follows the back's edge: body layer omits it, tail layer shows only it. */
  .nina-body-img { clip-path: polygon(0 0, 82.4% 0, 82.4% 15.1%, 87% 17%, 93.5% 25.8%, 94% 26.6%, 100% 26.6%, 100% 100%, 0 100%); }
  .nina-tail-img { clip-path: polygon(82.4% 0, 100% 0, 100% 26.6%, 94% 26.6%, 93.5% 25.8%, 87% 17%, 82.4% 15.1%); transform-origin: 89.8% 21%; animation: nina-wag 1.2s ease-in-out infinite alternate; }
  .nina.is-happy .nina-tail-img, .nina.is-walking .nina-tail-img { animation-duration: 0.3s; }

  /* Lean into the direction of travel, and hop while walking. */
  .nina .sprite { transform-origin: 50% 100%; }
  .nina.is-walking .sprite { transform: rotate(calc(var(--face, 1) * 6deg)); }
  .nina.is-walking .nina-pup { animation: nina-hop 0.34s ease-in-out infinite alternate; }
  .nina.is-happy:not(.is-walking) .nina-pup { animation: nina-happy 0.5s ease-in-out 2; }

  @keyframes nina-wag { from { transform: rotate(-9deg); } to { transform: rotate(11deg); } }
  @keyframes nina-breathe { to { transform: scale(1.015, 1.035); } }
  @keyframes nina-hop { from { transform: translateY(0) rotate(-3deg); } to { transform: translateY(-7px) rotate(3deg); } }
  @keyframes nina-happy { 50% { transform: translateY(-8px) scale(1.03, 0.98); } }

  @media (max-width: 600px) { .nina { width: 72px; height: 83px; } .nina .bubble { width: 200px; margin-left: -100px; } }
  @media (prefers-reduced-motion: reduce) {
    .nina-pup, .nina-tail-img { animation: none !important; }
    .nina .sprite { transform: none !important; }
  }
</style>
