<button class="toggle" type="button" data-theme-toggle aria-label="Toggle light/dark theme">
  <span class="sun" aria-hidden="true">☀</span>
  <span class="moon" aria-hidden="true">☾</span>
</button>

<style>
  .toggle {
    background: transparent; border: 1px solid var(--border); color: var(--text);
    width: 40px; height: 40px; border-radius: 50%; cursor: pointer; font-size: 1.1rem;
    transition: background 0.2s;
  }
  .toggle:hover { background: var(--accent-soft); }
  :global([data-theme='dark']) .sun, :global([data-theme='light']) .moon { display: none; }
</style>
