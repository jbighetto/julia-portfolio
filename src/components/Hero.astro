---
import { site } from '../data/site';
---
<section class="hero container">
  <p class="eyebrow">{site.intro}</p>
  <h1>
    {site.catchphrase.lead} <span class="accent">{site.catchphrase.emphasis}</span>
  </h1>
  <p class="lede">Hi, I’m {site.name}. {site.role}.</p>
  <div class="cta">
    <a class="btn btn-primary" href="/about">Get to know me</a>
    <a class="btn btn-ghost" href={site.resume} download>Download résumé</a>
  </div>
</section>

<style>
  .hero { padding-block: clamp(4rem, 12vw, 8rem) clamp(2rem, 6vw, 4rem); }
  .accent { color: var(--accent); display: inline-block; }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 52ch; margin-top: 1.5rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  .hero > * { animation: rise 0.8s ease both; }
  .hero > :nth-child(2) { animation-delay: 0.1s; }
  .hero > :nth-child(3) { animation-delay: 0.2s; }
  .hero > :nth-child(4) { animation-delay: 0.3s; }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } }
</style>
