---
import { focusAreas } from '../data/site';
const accents = ['var(--accent)', 'var(--terracotta)', 'var(--olive)'];
---
<section class="section container">
  <p class="eyebrow">Where I want to build</p>
  <h2>Products that change lives for the better.</h2>
  <div class="grid">
    {focusAreas.map((area, i) => (
      <article class="card" data-reveal style={`--tint:${accents[i % accents.length]}; transition-delay:${i * 100}ms`}>
        <span class="dot" aria-hidden="true"></span>
        <h3>{area.title}</h3>
        <p>{area.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .grid { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin-top: 2rem; }
  .card { border-top: 4px solid var(--tint); }
  .card p { color: var(--muted); margin: 0; }
  .dot { display: block; width: 12px; height: 12px; border-radius: 50%; background: var(--tint); margin-bottom: 1rem; }
</style>
