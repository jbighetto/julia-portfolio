---
// Nina: one illustration, two layers. The tail is a clipped copy of the same image so it
// can wag on its own while the body stays put (see Nina.astro for the animations).
const src = '/nina/nina.webp';
---
<span class="nina-pup">
  <img class="nina-body-img" src={src} alt="Nina the dog" width="360" height="413" draggable="false" />
  <img class="nina-tail-img" src={src} alt="" aria-hidden="true" width="360" height="413" draggable="false" />
</span>
