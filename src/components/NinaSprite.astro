---
// Nina, drawn as inline SVG (faces right). Animated via the classes below;
// the state classes (.is-walking, .is-happy) live on the parent .nina element.
---
<svg class="nina-svg" viewBox="0 0 150 112" role="img" aria-label="Nina the dog" xmlns="http://www.w3.org/2000/svg">
  <ellipse class="nina-shadow" cx="76" cy="104" rx="52" ry="5" fill="#000" opacity="0.14" />

  <!-- far legs -->
  <g class="nina-leg nina-leg-b"><rect x="48" y="62" width="12" height="38" rx="6" fill="#94562c" /><ellipse cx="54" cy="100" rx="8" ry="4" fill="#94562c" /></g>
  <g class="nina-leg nina-leg-a"><rect x="96" y="62" width="12" height="38" rx="6" fill="#94562c" /><ellipse cx="102" cy="100" rx="8" ry="4" fill="#94562c" /></g>

  <!-- tail -->
  <g class="nina-tail">
    <path d="M30 56 C12 54 6 34 20 24" stroke="#b9703e" stroke-width="9" stroke-linecap="round" fill="none" />
    <circle cx="20" cy="24" r="7" fill="#d58f5a" /><circle cx="14" cy="32" r="5" fill="#d58f5a" />
  </g>

  <!-- body: ellipse + curls for the curly coat -->
  <ellipse cx="72" cy="58" rx="46" ry="24" fill="#b9703e" />
  <g fill="#d58f5a">
    <circle cx="42" cy="40" r="9" /><circle cx="58" cy="35" r="9" /><circle cx="75" cy="34" r="9" />
    <circle cx="91" cy="37" r="9" /><circle cx="104" cy="44" r="8" />
  </g>
  <g fill="#b9703e">
    <circle cx="40" cy="74" r="8" /><circle cx="56" cy="80" r="8" /><circle cx="74" cy="81" r="8" /><circle cx="92" cy="78" r="8" />
  </g>
  <g stroke="#94562c" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.55">
    <path d="M46 52 q6 -7 12 0" /><path d="M64 48 q6 -7 12 0" /><path d="M82 52 q6 -7 12 0" /><path d="M56 64 q6 -7 12 0" /><path d="M76 66 q6 -7 12 0" />
  </g>

  <!-- near legs -->
  <g class="nina-leg nina-leg-a"><ellipse cx="44" cy="66" rx="14" ry="14" fill="#b9703e" /><rect x="37" y="64" width="13" height="36" rx="6.5" fill="#b9703e" /><ellipse cx="43" cy="100" rx="9" ry="4.5" fill="#d58f5a" /></g>
  <g class="nina-leg nina-leg-b"><rect x="92" y="64" width="13" height="36" rx="6.5" fill="#b9703e" /><ellipse cx="98" cy="100" rx="9" ry="4.5" fill="#d58f5a" /></g>

  <!-- chest patch -->
  <ellipse cx="106" cy="66" rx="7" ry="12" fill="#fff7ea" />

  <!-- head -->
  <g class="nina-head">
    <ellipse cx="106" cy="52" rx="15" ry="17" fill="#b9703e" />
    <circle cx="114" cy="36" r="20" fill="#b9703e" />
    <g fill="#d58f5a"><circle cx="106" cy="19" r="7" /><circle cx="116" cy="16" r="7" /><circle cx="125" cy="21" r="6" /></g>
    <ellipse cx="128" cy="45" rx="15" ry="10" fill="#fff7ea" />
    <circle cx="121" cy="55" r="5" fill="#fff7ea" /><circle cx="130" cy="55" r="4.5" fill="#fff7ea" />
    <ellipse cx="120" cy="29" rx="4.2" ry="8.5" fill="#fff7ea" />
    <g class="nina-eyes" fill="#2b1b17">
      <ellipse class="nina-eye" cx="114" cy="35" rx="3.4" ry="3.8" /><ellipse class="nina-eye" cx="128" cy="34" rx="2.8" ry="3.2" />
    </g>
    <circle cx="115" cy="33.8" r="1.1" fill="#fff" /><circle cx="129" cy="33" r="0.9" fill="#fff" />
    <ellipse cx="141" cy="41" rx="5.5" ry="4.2" fill="#4a2723" /><ellipse cx="139.5" cy="39.6" rx="1.8" ry="1" fill="#fff" opacity="0.5" />
    <path d="M132 49 q6 4 11 -1" stroke="#4a2723" stroke-width="1.6" fill="none" stroke-linecap="round" />
    <ellipse class="nina-tongue" cx="138" cy="55" rx="3.6" ry="5.5" fill="#d9677a" />
    <!-- floppy ear -->
    <g class="nina-ear">
      <path d="M104 24 C90 28 86 54 94 68 C101 76 112 66 109 50 C108 40 109 31 104 24Z" fill="#94562c" />
      <circle cx="96" cy="66" r="5" fill="#94562c" /><circle cx="104" cy="68" r="4.5" fill="#94562c" />
    </g>
  </g>

  <!-- collar and ESA tag -->
  <path d="M96 52 Q106 66 118 58" stroke="#8a1f2d" stroke-width="5" fill="none" stroke-linecap="round" />
  <g class="nina-tags">
    <circle cx="106" cy="68" r="4" fill="#c9ccd2" stroke="#8d929c" stroke-width="1" />
  </g>
</svg>
