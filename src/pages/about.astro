---
import BaseLayout from '../layouts/BaseLayout.astro';
import { bio, quickFacts, site } from '../data/site';
import OutsideWork from '../components/OutsideWork.astro';
---
<BaseLayout title="About" description={`About ${site.name}`}>
  <section class="container section" data-nina="about-intro">
    <p class="eyebrow">About</p>
    <h1>Hi, I’m Julia.</h1>
    <div class="layout">
      <div class="photo" role="img" aria-label="Photo placeholder">Photo coming soon</div>
      <div>
        {bio.map((block) => (
          <div data-reveal>
            <h2>{block.heading}</h2>
            <p>{block.text}</p>
          </div>
        ))}
        <OutsideWork />
        <h2>Quick facts</h2>
        <dl class="facts" data-reveal data-nina="about-facts">
          {quickFacts.map((f) => (<><dt>{f.label}</dt><dd>{f.value}</dd></>))}
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .layout { display: grid; gap: 2.5rem; grid-template-columns: 1fr; margin-top: 2rem; }
  .photo {
    aspect-ratio: 4 / 5; border-radius: var(--radius); display: grid; place-items: center;
    background: linear-gradient(145deg, var(--accent-soft), var(--sand)); color: var(--muted);
    border: 1px dashed var(--border); max-width: 360px;
  }
  h2 { font-size: 1.5rem; }
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.6rem 1.5rem; margin: 0; }
  dt { font-weight: 700; color: var(--accent); }
  dd { margin: 0; color: var(--muted); }
  @media (max-width: 560px) { .facts { grid-template-columns: 1fr; gap: 0.1rem; } dd { margin-bottom: 0.6rem; } }
  @media (min-width: 800px) { .layout { grid-template-columns: 320px 1fr; } .photo { position: sticky; top: 100px; align-self: start; } }
</style>
