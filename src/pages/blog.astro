---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Blog" description="Blog coming soon.">
  <section class="container section">
    <p class="eyebrow">Blog · Work in progress</p>
    <h1>Words are coming.</h1>
    <p class="lede">I’m working on notes about product, engineering, and life in Barcelona. Check back soon.</p>
    <a class="btn btn-ghost" href="/">Back home</a>
  </section>
</BaseLayout>

<style>
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 52ch; margin-bottom: 2rem; }
</style>
